{
  "name": "lumen-bloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "現在地の太陽位置と天気をリアルタイムに映す、プロシージャル花瓶の3Dウォールペーパー",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.6",
    "wrangler": "^4.125.0"
  }
}
